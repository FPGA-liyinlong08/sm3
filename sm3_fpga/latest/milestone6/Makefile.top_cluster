SIM ?= verilator
CORE_NUM ?= 16
CTX_NUM ?= 32
FAST_DEPTH ?= 32
POOL_DEPTH ?= 512
CLUSTER_NUM ?= 4
# Verilator 5.020 miscompiles the registered cluster allocator at the old
# per-variant -Os/-O1 levels.  -O0 is the stable build for the final 2x8
# regression.  The final four-cluster RTL still hits the Verilator 5.020
# four-cluster crash; it was gated out by post-synth timing and never P&R'd.
# This is a simulator-only setting and does not change cycle counts.
OPT := -O0
export OPT
NMSG ?= 300
PROFILE ?= short_heavy
TOPLEVEL_LANG ?= verilog
TOPLEVEL := sm3_accel_cluster_top
MODULE := test_sm3_accel_top
COCOTB_TEST_MODULES := test_sm3_accel_top
export PYTHONPATH := $(CURDIR)/tb:$(PYTHONPATH)
VERILOG_SOURCES := $(CURDIR)/rtl/core/sm3_core.sv \
                   $(CURDIR)/rtl/front_end/sm3_block_builder.sv \
                   $(CURDIR)/rtl/context/sm3_block_pool.sv \
                   $(CURDIR)/rtl/context/sm3_pool_engine.sv \
                   $(CURDIR)/rtl/top/sm3_accel_cluster.sv \
                   $(CURDIR)/rtl/top/sm3_accel_cluster_top.sv
COMPILE_ARGS += --timing --O0 -Wall -Wno-fatal -Wno-PINCONNECTEMPTY \
                -GCORE_NUM=$(CORE_NUM) -GCTX_NUM=$(CTX_NUM) \
                -GFAST_DEPTH=$(FAST_DEPTH) -GPOOL_DEPTH=$(POOL_DEPTH) \
                -GCLUSTER_NUM=$(CLUSTER_NUM)
SIM_BUILD := sim_build_top_cluster_$(CLUSTER_NUM)x$(CORE_NUM)_ctx$(CTX_NUM)_pool$(POOL_DEPTH)
COCOTB_RESULTS_FILE := results_top_cluster_$(CLUSTER_NUM)x$(CORE_NUM).xml
export NMSG PROFILE POOL_DEPTH

include $(shell cocotb-config --makefiles)/Makefile.sim
