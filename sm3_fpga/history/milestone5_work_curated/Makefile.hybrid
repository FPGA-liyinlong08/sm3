SIM ?= verilator
CORE_NUM ?= 8
CTX_NUM ?= 32
FAST_DEPTH ?= 32
FAST_QUOTA ?= 3
TOPLEVEL_LANG ?= verilog
TOPLEVEL := sm3_hybrid_engine
COCOTB_TEST_MODULES := test_sm3_hybrid
export PYTHONPATH := $(CURDIR)/tb:$(PYTHONPATH)
VERILOG_SOURCES := $(CURDIR)/rtl/core/sm3_core.sv $(CURDIR)/rtl/context/sm3_context_store.sv $(CURDIR)/rtl/context/sm3_hybrid_engine.sv
COMPILE_ARGS += --timing -Wall -Wno-fatal -Wno-PINCONNECTEMPTY -GCORE_NUM=$(CORE_NUM) -GCTX_NUM=$(CTX_NUM) -GFAST_DEPTH=$(FAST_DEPTH) -GFAST_QUOTA=$(FAST_QUOTA)
SIM_BUILD := sim_build_hybrid_$(CORE_NUM)_$(CTX_NUM)_$(FAST_DEPTH)
COCOTB_RESULTS_FILE := results_hybrid_$(CORE_NUM)_$(CTX_NUM)_$(FAST_DEPTH).xml

include $(shell cocotb-config --makefiles)/Makefile.sim
