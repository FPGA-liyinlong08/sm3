SIM ?= verilator
CORE_NUM ?= 8
CTX_NUM ?= 32
FAST_DEPTH ?= 32
FAST_QUOTA ?= 3
STICKY_QUANTUM_BUSY ?= 2
STICKY_QUANTUM_IDLE ?= 8
FAST_WATERMARK ?= 1
FAST_PRESSURE_HOLD ?= 32
TOPLEVEL_LANG ?= verilog
TOPLEVEL := sm3_adaptive_engine
COCOTB_TEST_MODULES := test_sm3_hybrid
export PYTHONPATH := $(CURDIR)/tb:$(PYTHONPATH)
VERILOG_SOURCES := $(CURDIR)/rtl/core/sm3_core.sv $(CURDIR)/rtl/context/sm3_context_store.sv $(CURDIR)/rtl/context/sm3_adaptive_engine.sv
COMPILE_ARGS += --timing -Wall -Wno-fatal -Wno-PINCONNECTEMPTY -GCORE_NUM=$(CORE_NUM) -GCTX_NUM=$(CTX_NUM) -GFAST_DEPTH=$(FAST_DEPTH) -GFAST_QUOTA=$(FAST_QUOTA) -GSTICKY_QUANTUM_BUSY=$(STICKY_QUANTUM_BUSY) -GSTICKY_QUANTUM_IDLE=$(STICKY_QUANTUM_IDLE) -GFAST_WATERMARK=$(FAST_WATERMARK) -GFAST_PRESSURE_HOLD=$(FAST_PRESSURE_HOLD)
SIM_BUILD := sim_build_adaptive_$(CORE_NUM)_$(CTX_NUM)_b$(STICKY_QUANTUM_BUSY)_i$(STICKY_QUANTUM_IDLE)_h$(FAST_PRESSURE_HOLD)
COCOTB_RESULTS_FILE := results_adaptive_$(CORE_NUM)_$(CTX_NUM).xml

include $(shell cocotb-config --makefiles)/Makefile.sim
