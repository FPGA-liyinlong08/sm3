SIM ?= verilator
CORE_NUM ?= 8
CTX_NUM ?= 32
FAST_DEPTH ?= 32
FAST_QUOTA ?= 3
STICKY_QUANTUM ?= 4
TOPLEVEL_LANG ?= verilog
TOPLEVEL := sm3_sticky_engine
COCOTB_TEST_MODULES := test_sm3_hybrid
export PYTHONPATH := $(CURDIR)/tb:$(PYTHONPATH)
VERILOG_SOURCES := $(CURDIR)/rtl/core/sm3_core.sv $(CURDIR)/rtl/context/sm3_context_store.sv $(CURDIR)/rtl/context/sm3_sticky_engine.sv
COMPILE_ARGS += --timing -Wall -Wno-fatal -Wno-PINCONNECTEMPTY -GCORE_NUM=$(CORE_NUM) -GCTX_NUM=$(CTX_NUM) -GFAST_DEPTH=$(FAST_DEPTH) -GFAST_QUOTA=$(FAST_QUOTA) -GSTICKY_QUANTUM=$(STICKY_QUANTUM)
SIM_BUILD := sim_build_sticky_$(CORE_NUM)_$(CTX_NUM)_q$(STICKY_QUANTUM)
COCOTB_RESULTS_FILE := results_sticky_$(CORE_NUM)_$(CTX_NUM)_q$(STICKY_QUANTUM).xml

include $(shell cocotb-config --makefiles)/Makefile.sim
