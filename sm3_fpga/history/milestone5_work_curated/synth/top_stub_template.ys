read_verilog -sv -DSYNTHESIS synth/sm3_core_stub.sv rtl/front_end/sm3_block_builder.sv rtl/context/sm3_block_pool.sv rtl/context/sm3_pool_engine.sv rtl/top/sm3_accel_top.sv
chparam -set CORE_NUM COREVAL -set CTX_NUM CTXVAL -set FAST_DEPTH 32 -set POOL_DEPTH 512 sm3_accel_top
hierarchy -check -top sm3_accel_top
synth_xilinx -family xcu -top sm3_accel_top -noiopad -noclkbuf -json synth/top_stub_COREVAL.json
stat -tech xilinx
