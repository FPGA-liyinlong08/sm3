# Original delivered zip (kept on disk, not tracked)
/*.zip

# Binary tool packages shipped with the archive
/sm3_fpga/tools/

# Large historical synthesis logs (scripts and reports are kept)
/sm3_fpga/history/milestone5_work_curated/synth/*.log
/sm3_fpga/history/milestone5_work_curated/synth/*.stdout
/sm3_fpga/history/milestone5_work_curated/synth/*.pid
/sm3_fpga/history/milestone5_work_curated/synth/*.rc
/sm3_fpga/logs/
/sm3_fpga/latest/milestone6/synth/*.log

# Vivado implementation artifacts
*.dcp
*.dcp.*
**/.Xil/
**/xsim.dir/
**/sim/obj_dir/
/work/vivado/sim_opt2/
**/vivado_*.backup.log
**/vivado_*.backup.jou

# Simulator waveform / compiled artifacts
*.wdb
*.pb
*.vcd
*.fst
*.wlf

# Python caches
__pycache__/
*.pyc

# Generated Vivado experiment directories and run logs
/work/vivado/timing_v1/synth*/
/work/vivado/timing_v1/baseline_synth/
/work/vivado/timing_v1/impl_v*/
/work/vivado/timing_v1/place_v*/
/work/vivado/timing_v1/route_v4*/
/work/vivado/timing_v1/route_v5*/
/work/vivado/timing_v1/**/*.log
/work/vivado/timing_v1/**/*.jou
/work/vivado/timing_v1/**/*.out
/work/vivado/timing_v1/**/*.backup.*
/work/vivado/timing_v1/**/run_stdout.log

# Cocotb simulation build artifacts
/sm3_fpga/latest/milestone6/sim_build*/

# Generated cocotb result XML files
/sm3_fpga/latest/milestone6/results*.xml

# Local pblock visualization dumps kept for the high-density experiments
/hd_visual/
